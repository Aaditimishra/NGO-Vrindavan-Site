<!DOCTYPE html>
<html lang="hi">
<head><%- include('partials/head') %></head>
<body class="<%= bodyClass %>">
<%- include('partials/header') %>
<%- include('partials/pagehero', { eyebrow: 'सेवा कार्य', title: c.seva.heroTitle, subtitle: c.seva.heroSubtitle, waveFill: '#FFFBF4' }) %>

<section class="section section-cream">
  <div class="container">
    <div class="sec-head reveal">
      <p style="font-size:1.12rem;color:var(--text)"><%= c.seva.intro %></p>
      <div class="ornament"><span></span><svg><use href="#i-lotus"/></svg><span></span></div>
    </div>

    <% c.seva.items.forEach(function(s, i){ %>
    <div class="split <%= i % 2 ? 'rev' : '' %>" style="margin-bottom:clamp(48px,6vw,86px)">
      <div class="split-art reveal">
        <div class="frame" style="aspect-ratio:4/3"><img src="<%= s.image %>" alt="<%= s.title %>" loading="lazy"></div>
      </div>
      <div class="reveal d1">
        <div class="mv-icon" style="margin-bottom:18px"><svg><use href="#i-<%= s.icon || 'lotus' %>"/></svg></div>
        <h2><%= s.title %></h2>
        <p style="color:var(--saffron);font-family:var(--deva);font-size:1.08rem"><%= s.short %></p>
        <p><%= s.text %></p>
        <a href="/donate" class="btn btn-teal">इस सेवा में सहयोग करें<svg><use href="#i-arrow"/></svg></a>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<section class="cta-band">
  <div class="container cta-inner">
    <div class="reveal"><h2><%= c.home.ctaHeading %></h2><p><%= c.home.ctaText %></p></div>
    <div class="reveal d1"><a href="/donate" class="btn btn-primary btn-lg"><svg><use href="#i-heart"/></svg><%= c.home.ctaBtnText %></a></div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>

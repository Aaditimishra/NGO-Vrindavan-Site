<!DOCTYPE html>
<html lang="hi">
<head><%- include('partials/head') %></head>
<body class="<%= bodyClass %>">
<%- include('partials/header') %>
<%- include('partials/pagehero', { eyebrow: 'समाचार', title: c.blog.heroTitle, subtitle: c.blog.heroSubtitle, waveFill: '#FFFBF4' }) %>

<section class="section section-cream">
  <div class="container">
    <% if (!c.blog.posts.length) { %>
      <p class="text-center" style="color:var(--muted)">अभी कोई समाचार प्रकाशित नहीं हुआ है।</p>
    <% } %>
    <div class="blog-grid">
      <% c.blog.posts.forEach(function(p, i){ %>
      <article class="blog-card reveal d<%= (i % 3) + 1 %>">
        <a href="/blog/<%= p.slug %>" class="blog-img"><img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy"></a>
        <div class="blog-body">
          <div class="blog-meta">
            <span><svg><use href="#i-calendar"/></svg><%= formatDate(p.date) %></span>
            <span><svg><use href="#i-user"/></svg><%= p.author %></span>
          </div>
          <h3><a href="/blog/<%= p.slug %>"><%= p.title %></a></h3>
          <p><%= p.excerpt %></p>
          <a href="/blog/<%= p.slug %>" class="seva-link">पूरा पढ़ें <svg><use href="#i-arrow"/></svg></a>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
</body>
</html>
